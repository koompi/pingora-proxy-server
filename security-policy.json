{
  "network_policies": {
    "default": "allow",
    "org_networks": {
      "isolation_mode": "permissive",
      "allow_internal_communication": true,
      "allow_external_communication": true,
      "exceptions": []
    }
  },
  "container_policies": {
    "memory_limit": "1024M",
    "cpu_limit": "1.0",
    "capabilities": {
      "drop_all": false,
      "allow": ["ALL"]
    },
    "security_options": {
      "no_new_privileges": false,
      "read_only_filesystem": false,
      "user_namespace_mode": "off"
    },
    "tmpfs_mounts": []
  }
}